# Q31. Find the latest loan application for each customer.
with cte as (select a.city as city ,a.customer_id as customer_id,b.application_id as application_id,b.loan_amount as loan_amount,b.application_date as application_date
 from customers as a inner join  loan_applications  as b on a.customer_id=b.customer_id)
